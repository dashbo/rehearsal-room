# Copy to .env and edit.

# Domain Caddy obtains a Let's Encrypt certificate for. It must resolve to
# this host, and ports 80 + 443 must be reachable from the internet.
APP_DOMAIN=rehearsal.example.com

# Image tag to run. "latest" tracks the main branch; pin a version (e.g.
# 0.1.0) for stable deploys. See github.com/dashbo/rehearsal-room/pkgs.
TAG=latest
